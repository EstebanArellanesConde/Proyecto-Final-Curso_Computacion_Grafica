<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{C3CFF0CC-F780-4848-9886-80A3198DE559}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <CourseBase Condition="'$(CourseBase)' == ''">$(MSBuildProjectDirectory)\..\ConfigInicial</CourseBase>
    <CourseLibraries>$(CourseBase)\External Libraries</CourseLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">$(DefaultPlatformToolset)</PlatformToolset>
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(ProjectDir)build\</OutDir>
    <IntDir>$(OutDir)obj\</IntDir>
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <AdditionalIncludeDirectories>$(CourseBase);$(CourseLibraries)\GLEW\include;$(CourseLibraries)\GLFW\include;$(CourseLibraries)\glm;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalLibraryDirectories>$(CourseLibraries);$(CourseLibraries)\GLFW\lib-vc2015;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>opengl32.lib;glew32.lib;glfw3.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="MapaJanitzio.cpp" />
    <ClInclude Include="ModelosJanitzio.h" />
    <None Include="Shader\mapa.vs" />
    <None Include="Shader\mapa.frag" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="CheckCourseBase" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(CourseBase)\Camera.h')" Text="Falta ConfigInicial al lado de Janitzio. Descarga el repositorio completo o indica su ubicación con la propiedad CourseBase." />
  </Target>
  <Target Name="CopySceneResources" AfterTargets="Build">
    <Copy SourceFiles="$(CourseBase)\glew32.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Shader\mapa.vs;$(MSBuildProjectDirectory)\Shader\mapa.frag"
          DestinationFolder="$(OutDir)Shader" SkipUnchangedFiles="true" />
    <Copy Condition="Exists('$(MSBuildProjectDirectory)\Assets\modelos.bin') And Exists('$(MSBuildProjectDirectory)\Assets\materiales.png')"
          SourceFiles="$(MSBuildProjectDirectory)\Assets\modelos.bin;$(MSBuildProjectDirectory)\Assets\materiales.png"
          DestinationFolder="$(OutDir)Assets" SkipUnchangedFiles="true" />
  </Target>
</Project>
